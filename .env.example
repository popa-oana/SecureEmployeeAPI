# Exemplu public: inlocuieste valorile in copia locala .env, pe care nu o publici.

# Cheie JWT HS256: minimum 32 de caractere; foloseste o valoare aleatorie.
# Generare locala: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=EXAMPLE_ONLY_REPLACE_WITH_A_RANDOM_JWT_KEY

# Parola contului employee_demo (acces la propria fisa publica).
DEMO_EMPLOYEE_PASSWORD=EXAMPLE_ONLY_CHANGE_EMPLOYEE_PASSWORD

# Parola contului hr_reader (citirea fiselor publice).
DEMO_READER_PASSWORD=EXAMPLE_ONLY_CHANGE_READER_PASSWORD

# Parola contului hr_admin (scriere si acces la date sensibile).
DEMO_ADMIN_PASSWORD=EXAMPLE_ONLY_CHANGE_ADMIN_PASSWORD
